# Cache policy for Cloudflare Workers static assets. Without this file every
# asset is served with `max-age=0, must-revalidate`.
# vite.config.js re-copies this file after the build because the AvatarKit
# plugin overwrites dist/_headers with only its WASM rule.

# Vite bundles are content-hashed and sit flat in /assets/, so they can never
# change under the same URL.
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

# AvatarKit also copies an unhashed glue file; keep it on the revalidating default.
/assets/avatar_core_wasm.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

# Media in public/ keeps stable file names: cache for a while, then refresh in
# the background. Rename a file (or its folder) to force an immediate update.
/assets/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/assets/cards/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/assets/videos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/assets/audio/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/assets/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
