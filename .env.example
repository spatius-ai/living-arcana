VITE_SPATIUS_APP_ID=""
VITE_SPATIUS_AVATAR_ID=""
VITE_SPATIUS_AVATAR_MAP={}
VITE_SPATIUS_REGION=ap-northeast
SPATIUS_APP_ID=""
SPATIUS_API_KEY=""
# Server-only credential; populate only in your local environment.
SPATIUS_REGION=ap-northeast
# Three Cards allows three new questions per anonymous browser each Singapore day
THREE_CARD_DAILY_QUESTION_LIMIT=3
THREE_CARD_QUOTA_TIME_ZONE=Asia/Singapore
# Reading LLM + fallback transcription go through OpenRouter
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_TRANSCRIBE_MODEL=openai/gpt-4o-mini-transcribe
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=""
ELEVENLABS_MODEL=eleven_flash_v2_5
# Realtime duplex STT (WebSocket); the key needs the Speech to Text permission
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_VOICE_MAP={}
OPENROUTER_VOICE_MODEL=openai/gpt-5.4-mini
